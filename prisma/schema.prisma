generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Userモデル
model User {
  user_id     String      @id @default(uuid())
  first_name  String
  last_name   String   
  e_mail      String   @unique
  password    String  
  birthday    String
  gender      String
  schedule_id Int[]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // 外部キー設定
  schedules UserSchedule[]
  cashes   Cash[]
}

// Screenモデル
model Screen {
  screen_id       Int      @id @default(autoincrement())
  screen_capacity Int

  // リレーション
  movie_schedule MovieSchedule[]
}

// movie_scheduleモデル
model MovieSchedule {
  movie_schedule_id Int @id @default(autoincrement())
  movie_id Int
  screen_id Int
  cinema_id Int
  start_time DateTime
  end_time DateTime
  created_at DateTime
  updated_at DateTime

  // 外部キー設定
  movie Movie @relation(fields: [movie_id], references: [movie_id])
  screen Screen @relation(fields: [screen_id], references: [screen_id])
  cinema Cinema @relation(fields: [cinema_id], references: [cinema_id])
  schedule Schedule[]
}

// Scheduleモデル
model Schedule {
  schedule_id   Int      @id @default(autoincrement())
  movie_schedule_id Int
  seat_id       Int  // seat_idを配列に変更

  // 外部キー設定
  schedule Cash[]
  users  UserSchedule[]
  movie_schedule MovieSchedule @relation(fields: [movie_schedule_id], references: [movie_schedule_id])
}

// Movieモデル
model Movie {
  movie_id     Int      @id @default(autoincrement())
  movie_name   String
  movie_detail String
  movie_time   Int
  category_id  Int
  movie_image1  String
  movie_image2  String
  movie_cast String
  movie_director String
  movie_start_date String
  movie_end_date String

  // 外部キー設定
  category Category @relation(fields: [category_id], references: [category_id])
  cashes     Cash[]
  movie_schedule MovieSchedule[]
}

// Seatモデル
model Seat {
  seat_id   Int      @id @default(autoincrement())
  seat_point String  @unique

}

// CashMethodモデル
model CashMethod {
  method_id Int      @id @default(autoincrement())
  method    String

  // リレーション
  cashes Cash[]
}

// Priceモデル
model Price {
  price_id Int @id @default(autoincrement())
  price_sum    Int
  ticket_id    String

  // リレーション
  ticket Ticket @relation(fields: [ticket_id], references: [ticket_id]) 
}

// Ticketモデル
model Ticket{
  ticket_id String @id @default(uuid())
  ticket_price Int

  //リレーション
  price Price[]
  cashes Cash[]
}

// Discountモデル
model Discount {
  discount_id   Int    @id @default(autoincrement())
  discount_type String

  // リレーション
  cashes Cash[]
}

// Categoryモデル
model Category {
  category_id   Int    @id @default(autoincrement())
  category_name String

  // リレーション
  movies Movie[]
}

// Cashモデル
model Cash {
  cash_id     Int @id @default(autoincrement()) //会計確定してからのID
  movie_id    Int //映画ID
  ticket_type   String //チケットの種類
  ticket_id   String @unique @default(uuid()) //発行されたチケットID
  schedule_id   Int //スケジュールID
  user_id     String //買ったユーザーID
  method_id   Int //支払い方法
  discount_id Int //割引情報
  price_sum   Int //支払いの合計金額(いる？)
  created_at  DateTime @default(now()) //購入日
  updated_at  DateTime @updatedAt //注文更新日
  
  // 外部キー設定
  user       User       @relation(fields: [user_id], references: [user_id])
  movie      Movie      @relation(fields: [movie_id], references: [movie_id])
  cashMethod CashMethod @relation(fields: [method_id], references: [method_id])
  ticket     Ticket      @relation(fields: [ticket_type], references: [ticket_id])
  discount   Discount   @relation(fields: [discount_id], references: [discount_id])
  schedule   Schedule   @relation(fields: [schedule_id], references: [schedule_id])
}

// timeモデル
model MovieTime {
  time_id Int @id @default(autoincrement())
  movie_start String

}

// UserScheduleモデル
model UserSchedule {

  user_id String
  user_schedule_id Int @id @default(autoincrement())


  schedule_id Int

  // 外部キー
  user User @relation(fields: [user_id], references: [user_id])
  schedule Schedule @relation(fields: [schedule_id], references: [schedule_id])

}

//Cinemaモデル
model Cinema{
  cinema_id Int @id @default(autoincrement())
  cinema_region String
  cinema_address String
  cinema_tel String
  cinema_email String
  cinema_detail String
  cinema_image String

  movie_schedule MovieSchedule[]
}

// inquiryテーブル
model Inquiry{
  inquiry_id Int @id @default(autoincrement())
  inquiry_subject String
  inquiry_content String
  inquiry_email String
  inquiry_category String @default("")
  created_at DateTime @default(now())
}